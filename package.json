{
  "name": "ecs-dev-desktop",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "reap": "sh scripts/reap-local.sh",
    "build": "turbo run build",
    "lint": "oxlint",
    "test": "turbo run test",
    "test:integ": "turbo run test:integ",
    "test:integ:local": "sh scripts/test-integ.sh",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:local": "sh scripts/test-e2e.sh",
    "check-deps": "bash scripts/check-latest-deps.sh",
    "check-deps:node": "node scripts/check-node-deps.mjs",
    "check-deps:images": "node scripts/check-image-pins.mjs",
    "dead-code": "knip --no-config-hints",
    "cpd": "jscpd --no-tips apps packages services",
    "test:fuzz": "echo \"For deep fuzzing, raise the interruptAfterTimeLimit plugin in fuzz-setup.ts to 60000 and run: pnpm turbo run test --force\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "react-router": "8.4.0",
      "sharp": "0.35.5",
      "postcss": "8.5.29"
    }
  }
}
