{
  "name": "@edd/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build && pnpm run build:server",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "vitest run",
    "test:integ": "vitest run --config vitest.integ.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:pw": "node scripts/run-playwright.mjs",
    "test:pw:live": "node scripts/run-playwright.mjs --config playwright.live.config.ts",
    "test:pw:live:provision": "tsx e2e/live-cloud-setup.ts",
    "test:pw:vscode": "node scripts/run-playwright.mjs --config playwright.vscode.config.ts",
    "screenshot": "tsx scripts/screenshot-ui.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=esm --log-level=warning '--banner:js=import { createRequire } from \"module\"; const require = createRequire(import.meta.url);' --external:next --external:ssh2 --outfile=dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1148.0",
    "@aws-sdk/client-codebuild": "^3.1148.0",
    "@aws-sdk/client-cost-explorer": "^3.1148.0",
    "@aws-sdk/client-ecr": "^3.1148.0",
    "@aws-sdk/client-pricing": "^3.1148.0",
    "@aws-sdk/client-sesv2": "^3.1148.0",
    "@aws-sdk/client-wafv2": "^3.1148.0",
    "@edd/api-client": "workspace:*",
    "@edd/api-contracts": "workspace:*",
    "@edd/auth": "workspace:*",
    "@edd/authz": "workspace:*",
    "@edd/cloudtrail-audit": "workspace:*",
    "@edd/cloudwatch-logs": "workspace:*",
    "@edd/cloudwatch-metrics": "workspace:*",
    "@edd/compute-ecs": "workspace:*",
    "@edd/config": "workspace:*",
    "@edd/control-plane": "workspace:*",
    "@edd/core": "workspace:*",
    "@edd/db": "workspace:*",
    "@edd/iam-preflight": "workspace:*",
    "@edd/storage-ec2": "workspace:*",
    "@xterm/xterm": "^6.0.0",
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1148.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-ec2": "^3.1148.0",
    "@aws-sdk/client-ecs": "^3.1148.0",
    "@axe-core/playwright": "4.13.0",
    "@edd/e2e": "workspace:*",
    "@edd/editor-monaco": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15"
  }
}
